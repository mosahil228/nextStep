# Copy this file to ".env" and fill in your Supabase values
# Project URL: Supabase → "Connect" button (top of dashboard)
# Key: Supabase → Project Settings → API Keys → Publishable key (starts with sb_publishable_)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
